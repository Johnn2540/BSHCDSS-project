{{#> admin/page-header title="Tutors" intro="Tutor accounts. Tutors can log in to view curriculum documents and announcements. Suspended tutors cannot log in."}}
  <a href="/admin/tutors/new" class="btn btn-primary">{{> icon name="plus" class="h-4 w-4"}} Add tutor</a>
{{/admin/page-header}}

<nav aria-label="Filter by status" class="mb-4 overflow-x-auto">
  <ul class="flex gap-1 border-b border-neutral-300">
    {{#each tabs}}
      <li>
        <a href="{{href}}" class="tab-link" {{#if active}}aria-current="page"{{/if}}>{{label}} <span class="tab-count">{{count}}</span></a>
      </li>
    {{/each}}
  </ul>
</nav>

{{#if tutors.length}}
  <div class="admin-card overflow-x-auto">
    <table class="admin-table">
      <caption class="sr-only">Tutor accounts</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Email</th>
          <th scope="col">Institution</th>
          <th scope="col">Status</th>
          <th scope="col">Last login</th>
          <th scope="col"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {{#each tutors}}
          <tr>
            <td><a href="/admin/tutors/{{id}}/edit" class="font-semibold text-brand-blue underline-offset-2 hover:underline">{{name}}</a></td>
            <td class="break-all">{{email}}</td>
            <td>{{institution}}</td>
            <td>
              {{#if (eq status "ACTIVE")}}<span class="badge badge-green">Active</span>{{/if}}
              {{#if (eq status "PENDING")}}<span class="badge badge-yellow">Pending</span>{{/if}}
              {{#if (eq status "SUSPENDED")}}<span class="badge badge-red">Suspended</span>{{/if}}
            </td>
            <td class="whitespace-nowrap">{{#if lastLoginAt}}{{formatDate lastLoginAt}}{{else}}<span class="text-neutral-500">Never</span>{{/if}}</td>
            <td>
              <div class="flex flex-wrap justify-end gap-x-3 gap-y-1">
                {{#if (eq status "PENDING")}}
                  <form method="post" action="/admin/tutors/{{id}}/approve" class="inline">
                    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                    <button type="submit" class="action-link text-brand-green!">Approve<span class="sr-only"> {{name}}</span></button>
                  </form>
                {{/if}}
                {{#if (eq status "ACTIVE")}}
                  {{#unless lastLoginAt}}
                    <form method="post" action="/admin/tutors/{{id}}/invite" class="inline">
                      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                      <button type="submit" class="action-link">Resend invitation<span class="sr-only"> to {{name}}</span></button>
                    </form>
                  {{/unless}}
                  <form method="post" action="/admin/tutors/{{id}}/suspend" class="inline">
                    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                    <button type="submit" class="action-link action-link-danger">Suspend<span class="sr-only"> {{name}}</span></button>
                  </form>
                {{/if}}
                {{#if (eq status "SUSPENDED")}}
                  <form method="post" action="/admin/tutors/{{id}}/reactivate" class="inline">
                    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                    <button type="submit" class="action-link">Reactivate<span class="sr-only"> {{name}}</span></button>
                  </form>
                {{/if}}
                <a href="/admin/tutors/{{id}}/edit" class="action-link">Edit<span class="sr-only"> {{name}}</span></a>
                <a href="/admin/tutors/{{id}}/delete" class="action-link action-link-danger">Delete<span class="sr-only"> {{name}}</span></a>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{#if pagination}}
    <nav aria-label="Pagination" class="mt-4 flex items-center gap-3 text-sm">
      {{#if pagination.prevHref}}<a href="{{pagination.prevHref}}" class="action-link">&larr; Previous</a>{{/if}}
      <span>Page {{pagination.page}} of {{pagination.pages}}</span>
      {{#if pagination.nextHref}}<a href="{{pagination.nextHref}}" class="action-link">Next &rarr;</a>{{/if}}
    </nav>
  {{/if}}
{{else}}
  <div class="admin-card p-8 text-center">
    <p class="text-neutral-700">No tutors here.</p>
    <a href="/admin/tutors/new" class="btn btn-primary mt-4">Add a tutor</a>
  </div>
{{/if}}
