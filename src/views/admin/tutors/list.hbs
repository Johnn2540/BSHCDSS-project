{{#> admin/page-header title="Tutors" intro="Manage tutor accounts and promote active tutors to content administrators. Content administrators can manage the site but cannot manage accounts or permissions. Suspended tutors cannot log in." actions=true}}
  <a href="/admin/tutors/new" class="btn btn-primary">{{> icon name="plus" class="h-4 w-4"}} Add tutor</a>
{{/admin/page-header}}

<nav aria-label="Filter by status" class="mb-4 overflow-x-auto">
  <ul class="flex gap-1 border-b border-neutral-300">
    {{#each tabs}}
      <li>
        <a href="{{href}}" class="tab-link" {{#if active}}aria-current="page"{{/if}}>{{label}} <span class="tab-count">{{count}}</span></a>
      </li>
    {{/each}}
  </ul>
</nav>

{{#if tutors.length}}
  <div class="admin-card overflow-x-auto">
    <table class="admin-table admin-table-stack">
      <caption class="sr-only">Tutor accounts</caption>
      <thead>
        <tr>
          <th scope="col">Tutor</th>
          <th scope="col">Institution</th>
          <th scope="col">Status</th>
          <th scope="col">Access</th>
          <th scope="col">Last login</th>
          <th scope="col"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {{#each tutors}}
          <tr>
            <td class="admin-cell-title">
              <div class="flex items-center gap-3">
                <span class="admin-initials" aria-hidden="true">{{nameInitials name}}</span>
                <div class="min-w-0">
                  <a href="/admin/tutors/{{id}}/edit" class="font-semibold text-brand-blue underline-offset-2 hover:underline">{{name}}</a>
                  <p class="break-all text-xs text-neutral-600">{{email}}</p>
                </div>
              </div>
            </td>
            <td data-label="Institution">{{#if institution}}{{institution}}{{else}}<span class="text-neutral-500">Not given</span>{{/if}}</td>
            <td data-label="Status">
              {{#if (eq status "ACTIVE")}}<span class="badge badge-green">Active</span>{{/if}}
              {{#if (eq status "PENDING")}}<span class="badge badge-yellow">Pending</span>{{/if}}
              {{#if (eq status "SUSPENDED")}}<span class="badge badge-red">Suspended</span>{{/if}}
            </td>
            <td data-label="Access">{{#if canManageContent}}<span class="badge badge-green">Content administrator</span>{{else}}<span class="badge badge-grey">Tutor</span>{{/if}}</td>
            <td data-label="Last login" class="whitespace-nowrap">{{#if lastLoginAt}}{{formatDate lastLoginAt}}{{else}}<span class="text-neutral-500">Never</span>{{/if}}</td>
            <td class="admin-cell-actions text-right">
              {{#> admin/row-menu label=name}}
                <a role="menuitem" class="row-menu-item" href="/admin/tutors/{{id}}/edit">{{> admin/menu-icon name="edit"}} Edit details</a>
                {{#if (eq status "PENDING")}}
                  <form method="post" action="/admin/tutors/{{id}}/approve" class="row-menu-form" role="none">
                    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                    <button type="submit" role="menuitem" class="row-menu-item row-menu-item-success">{{> admin/menu-icon name="approve"}} Approve account</button>
                  </form>
                {{/if}}
                {{#if (eq status "ACTIVE")}}
                  {{#unless lastLoginAt}}
                    <form method="post" action="/admin/tutors/{{id}}/invite" class="row-menu-form" role="none">
                      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                      <button type="submit" role="menuitem" class="row-menu-item">{{> admin/menu-icon name="invite"}} Resend invitation</button>
                    </form>
                  {{/unless}}
                {{/if}}
                {{#if canManageContent}}
                  <form method="post" action="/admin/tutors/{{id}}/demote" class="row-menu-form" role="none">
                    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                    <button type="submit" role="menuitem" class="row-menu-item row-menu-item-danger">{{> admin/menu-icon name="revoke"}} Revoke admin access</button>
                  </form>
                {{else}}
                  {{#if (eq status "ACTIVE")}}
                    <form method="post" action="/admin/tutors/{{id}}/promote" class="row-menu-form" role="none">
                      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                      <button type="submit" role="menuitem" class="row-menu-item">{{> admin/menu-icon name="promote"}} Promote to content admin</button>
                    </form>
                  {{/if}}
                {{/if}}
                <div class="row-menu-sep" role="separator"></div>
                {{#if (eq status "ACTIVE")}}
                  <form method="post" action="/admin/tutors/{{id}}/suspend" class="row-menu-form" role="none">
                    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                    <button type="submit" role="menuitem" class="row-menu-item row-menu-item-danger">{{> admin/menu-icon name="suspend"}} Suspend account</button>
                  </form>
                {{/if}}
                {{#if (eq status "SUSPENDED")}}
                  <form method="post" action="/admin/tutors/{{id}}/reactivate" class="row-menu-form" role="none">
                    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                    <button type="submit" role="menuitem" class="row-menu-item">{{> admin/menu-icon name="reactivate"}} Reactivate account</button>
                  </form>
                {{/if}}
                <a role="menuitem" class="row-menu-item row-menu-item-danger" href="/admin/tutors/{{id}}/delete">{{> admin/menu-icon name="delete"}} Delete account</a>
              {{/admin/row-menu}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{#if pagination}}
    <nav aria-label="Pagination" class="mt-4 flex items-center gap-3 text-sm">
      {{#if pagination.prevHref}}<a href="{{pagination.prevHref}}" class="action-link">&larr; Previous</a>{{/if}}
      <span>Page {{pagination.page}} of {{pagination.pages}}</span>
      {{#if pagination.nextHref}}<a href="{{pagination.nextHref}}" class="action-link">Next &rarr;</a>{{/if}}
    </nav>
  {{/if}}
{{else}}
  <div class="admin-card p-8 text-center">
    <p class="text-neutral-700">No tutors here.</p>
    <a href="/admin/tutors/new" class="btn btn-primary mt-4">Add a tutor</a>
  </div>
{{/if}}
