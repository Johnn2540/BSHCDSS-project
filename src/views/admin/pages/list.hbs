{{> admin/page-header title="Page content" intro="Edit the text on each page of the website. Pages match the site menu, so they can be edited but not added or removed."}}

<ul class="grid gap-4 md:grid-cols-2">
  {{#each pages}}
    <li class="admin-card flex flex-col p-5">
      <h2 class="text-lg font-bold">{{label}}</h2>
      <p class="mt-1 flex-1 text-sm text-neutral-700">{{description}}</p>
      <div class="mt-4 flex items-center justify-between gap-3">
        <span class="text-xs text-neutral-600">{{#if updatedAt}}Last saved {{formatDate updatedAt}}{{else}}Showing default text{{/if}}</span>
        <a href="/admin/pages/{{slug}}/edit" class="btn btn-primary py-2">Edit<span class="sr-only"> {{label}}</span></a>
      </div>
    </li>
  {{/each}}
</ul>
