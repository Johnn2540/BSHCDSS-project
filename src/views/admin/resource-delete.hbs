{{> admin/page-header title=title back=resource.base backLabel=resource.label}}

<div class="admin-card max-w-2xl border-t-4 border-t-brand-red p-5 sm:p-8">
  <p class="text-neutral-800">Are you sure you want to delete this {{resource.singular}}?</p>
  <p class="mt-3 text-lg font-semibold">{{itemTitle}}</p>
  {{#if warning}}
    <p class="mt-4 rounded border-l-4 border-brand-yellow bg-yellow-50 px-4 py-3 text-sm text-neutral-900">{{warning}}</p>
  {{/if}}
  <p class="mt-4 text-sm text-neutral-700">This cannot be undone.</p>
  <form method="post" action="{{resource.base}}/{{item.id}}/delete" class="mt-6 flex flex-wrap gap-3">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <button type="submit" class="btn bg-brand-red text-white hover:bg-red-700 focus-visible:outline-brand-red">Yes, delete</button>
    <a href="{{resource.base}}" class="btn border border-neutral-300 bg-white text-neutral-800 hover:bg-neutral-50 focus-visible:outline-brand-blue">Cancel</a>
  </form>
</div>
