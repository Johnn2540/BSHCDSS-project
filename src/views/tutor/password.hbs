<section>
  {{> tutor/header title="Change password" summary="Choose a new password for your account. You'll stay logged in here; other devices will be signed out."}}
  {{#if errors}}{{#each errors}}{{#if @first}}
    <div role="alert" class="mt-6 max-w-2xl rounded border-l-4 border-brand-red bg-red-50 px-4 py-3 text-sm text-red-900">Please correct the highlighted fields below.</div>
  {{/if}}{{/each}}{{/if}}
  <div class="mt-8">{{> account/password-form}}</div>
</section>
