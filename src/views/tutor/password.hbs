<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
  {{> flash}}
  <p class="text-xs font-semibold uppercase tracking-wider text-brand-green-dark">Tutor Portal</p>
  <h1 class="mt-2 text-3xl font-bold text-brand-blue" data-motion="fade">Change password</h1>
  <p class="mt-3 max-w-2xl text-neutral-600">Choose a new password for your account. You'll stay logged in here; other devices will be signed out.</p>
  <nav aria-label="Tutor Portal" class="mt-8 grid grid-cols-2 gap-2 rounded-xl border border-neutral-200 bg-neutral-50 p-2 sm:flex sm:flex-wrap" data-tutor-nav>
    {{#each tutorNavigation}}<a href="{{href}}" class="tutor-nav-link">{{label}}</a>{{/each}}
  </nav>
  {{#if errors}}{{#each errors}}{{#if @first}}
    <div role="alert" class="mt-6 max-w-2xl rounded border-l-4 border-brand-red bg-red-50 px-4 py-3 text-sm text-red-900">Please correct the highlighted fields below.</div>
  {{/if}}{{/each}}{{/if}}
  <div class="mt-8">{{> account/password-form}}</div>
</section>
