<section>
  {{> tutor/header overview=true}}
  <div class="mt-9 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-lg font-semibold text-neutral-900">Shared resources</h2>
    <p class="text-xs text-neutral-600">Browse by section</p>
  </div>
  <div class="mt-5 grid gap-5 md:grid-cols-3" data-tutor-sections>
    {{#each sections}}
      <a href="{{href}}" class="tutor-resource-card motion-card group" data-motion="enter">
        <div class="flex items-center justify-between gap-3">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/8 text-brand-blue">{{> icon name=icon class="h-6 w-6"}}</span>
          {{> icon name="arrow" class="h-4 w-4 text-neutral-400"}}
        </div>
        <h3 class="mt-6 text-lg font-bold text-neutral-900">{{page.title}}</h3>
        {{#if page.summary}}<p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-600">{{page.summary}}</p>{{/if}}
        <p class="mt-6 flex items-baseline gap-2"><span class="text-3xl font-bold tracking-tight text-brand-blue">{{total}}</span><span class="text-xs font-medium text-neutral-600">published file{{#unless (eq total 1)}}s{{/unless}}</span></p>
        <span class="mt-5 flex items-center justify-between gap-2 border-t border-neutral-200 pt-4 text-sm font-semibold text-brand-blue">Open section {{> icon name="arrow" class="motion-arrow h-4 w-4"}}</span>
      </a>
    {{/each}}
  </div>
  <aside class="portal-help" aria-labelledby="portal-help-heading">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-blue-100 bg-white text-brand-blue" aria-hidden="true">{{> icon name="mail" class="h-5 w-5"}}</span>
    <div class="min-w-0 flex-1"><h2 id="portal-help-heading" class="text-base font-semibold text-neutral-900">{{page.helpHeading}}</h2>
      {{#if page.helpText}}<p class="mt-2 max-w-3xl text-sm leading-relaxed text-neutral-600">{{page.helpText}}</p>{{/if}}
      <a href="mailto:{{site.contact.email}}" class="action-link mt-3 inline-flex min-h-11 items-center gap-2">Contact the project team {{> icon name="arrow" class="h-4 w-4"}}</a>
    </div>
  </aside>
</section>
