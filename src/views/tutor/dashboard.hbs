<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
  {{> tutor/header}}
  <div class="mt-9 grid gap-5 md:grid-cols-3" data-tutor-sections>
    {{#each sections}}
      <a href="{{href}}" class="tutor-resource-card motion-card group" data-motion="enter">
        <div class="flex items-center justify-between gap-3">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/8 text-brand-blue">{{> icon name=icon class="h-6 w-6"}}</span>
          <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-600">{{total}} file{{#unless (eq total 1)}}s{{/unless}}</span>
        </div>
        <h2 class="mt-6 text-xl font-bold text-brand-blue">{{page.title}}</h2>
        {{#if page.summary}}<p class="mt-3 text-sm leading-relaxed text-neutral-600">{{page.summary}}</p>{{/if}}
        <span class="mt-7 flex items-center gap-2 text-sm font-semibold text-brand-green-dark">Open section {{> icon name="arrow" class="motion-arrow h-4 w-4"}}</span>
      </a>
    {{/each}}
  </div>
  <aside class="mt-10 rounded-xl border border-brand-blue/15 bg-brand-blue/4 p-6 sm:p-8" aria-labelledby="portal-help-heading">
    <h2 id="portal-help-heading" class="text-lg font-semibold text-brand-blue">{{page.helpHeading}}</h2>
    {{#if page.helpText}}<p class="mt-2 max-w-3xl text-sm leading-relaxed text-neutral-700">{{page.helpText}}</p>{{/if}}
    <a href="mailto:{{site.contact.email}}" class="action-link mt-4 inline-flex items-center gap-2">{{> icon name="mail" class="h-4 w-4"}} Contact the project team</a>
  </aside>
</section>
