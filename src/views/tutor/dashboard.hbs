<section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
  {{> flash}}
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-green">Tutor area</p>
      <h1 class="mt-1 text-2xl font-bold text-brand-blue sm:text-3xl">Welcome, {{currentUser.name}}</h1>
    </div>
    {{> logout-form}}
  </div>
  <p class="mt-8 rounded border border-dashed border-neutral-300 p-6 text-neutral-700">
    Your profile, curriculum documents and announcements will appear here.
  </p>
</section>
