<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
  {{> flash}}
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-green-dark">Tutor area</p>
      <h1 class="mt-1 text-2xl font-bold text-brand-blue sm:text-3xl">Welcome, {{currentUser.name}}</h1>
    </div>
    {{> logout-form}}
  </div>
  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 rounded-lg border border-neutral-200 bg-neutral-50 p-5 text-sm">
    <p><span class="font-semibold text-neutral-900">Account:</span> {{currentUser.email}}</p>
    <a href="/curriculum" class="action-link">Visit the public curriculum page {{> icon name="arrow" class="inline h-4 w-4"}}</a>
  </div>
  <div class="mt-10">{{> document-library library=library page=page action="/tutor" showAudience=true}}</div>
</section>
