<section class="auth-wrap">
  <div class="auth-card">
    <h1 class="text-2xl font-bold text-brand-blue">Log in</h1>
    <p class="mt-2 text-sm text-neutral-700">For project administrators and registered tutors.</p>

    <div class="mt-6">
      {{> flash}}
      {{> form-error}}
    </div>

    <form method="post" action="/login" novalidate class="space-y-5">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div>
        <label for="email" class="form-label">Email address</label>
        <input id="email" name="email" type="email" autocomplete="username" required value="{{email}}" class="form-input">
      </div>
      <div>
        <div class="flex items-baseline justify-between gap-4">
          <label for="password" class="form-label">Password</label>
          <a href="/forgot-password" class="text-sm text-brand-blue underline-offset-2 hover:underline">Forgot password?</a>
        </div>
        <input id="password" name="password" type="password" autocomplete="current-password" required class="form-input">
      </div>
      <button type="submit" class="btn btn-primary w-full">Log in</button>
    </form>

    <p class="mt-6 border-t border-neutral-200 pt-4 text-xs text-neutral-600">
      Tutor accounts are created by the project administrator. Contact the project team if you need access.
    </p>
  </div>
</section>
