<section class="auth-wrap">
  <div class="auth-card">
    <h1 class="text-2xl font-bold text-brand-blue">Forgot your password?</h1>

    {{#if sent}}
      <div role="status" class="mt-6 rounded border-l-4 border-brand-green bg-green-50 px-4 py-3 text-sm text-green-900">
        If an active account exists for that email address, we have sent a link to reset the password. The link expires in one hour.
      </div>
      <p class="mt-6 text-sm"><a href="/login" class="font-semibold text-brand-blue underline-offset-2 hover:underline">Back to log in</a></p>
    {{else}}
      <p class="mt-2 text-sm text-neutral-700">Enter your email address and we'll send you a link to reset your password.</p>
      <div class="mt-6">{{> form-error}}</div>
      <form method="post" action="/forgot-password" novalidate class="space-y-5">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div>
          <label for="email" class="form-label">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email" required value="{{email}}" class="form-input">
        </div>
        <button type="submit" class="btn btn-primary w-full">Send reset link</button>
      </form>
      <p class="mt-6 text-sm"><a href="/login" class="text-brand-blue underline-offset-2 hover:underline">Back to log in</a></p>
    {{/if}}
  </div>
</section>
