<section class="auth-wrap">
  <div class="auth-card">
    <h1 class="text-2xl font-bold text-brand-blue">Choose a password</h1>

    {{#if invalid}}
      <div role="alert" class="mt-6 rounded border-l-4 border-brand-red bg-red-50 px-4 py-3 text-sm text-red-900">
        This link is invalid or has expired. Links can only be used once. You can request a new one below.
      </div>
      <a href="/forgot-password" class="btn btn-primary mt-6 w-full">Request a new link</a>
    {{else}}
      <p class="mt-2 text-sm text-neutral-700">Choose a new password of at least 10 characters.</p>
      <div class="mt-6">{{> form-error}}</div>
      <form method="post" action="/reset-password/{{token}}" novalidate class="space-y-5">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div>
          <label for="password" class="form-label">New password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" required minlength="10" maxlength="72" class="form-input">
        </div>
        <div>
          <label for="confirmPassword" class="form-label">Confirm new password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required minlength="10" maxlength="72" class="form-input">
        </div>
        <button type="submit" class="btn btn-primary w-full">Save password</button>
      </form>
    {{/if}}
  </div>
</section>
