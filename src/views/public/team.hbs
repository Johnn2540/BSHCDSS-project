{{> page-hero title=page.title summary=page.summary}}

<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
  {{#if team.keyCount}}
    <section aria-labelledby="key-team-heading">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 id="key-team-heading" class="section-heading">{{page.teamHeading}}</h2>
          {{#if page.teamIntro}}<p class="mt-4 max-w-3xl text-base leading-relaxed text-neutral-600">{{page.teamIntro}}</p>{{/if}}
        </div>
        <span class="team-count">{{team.keyCount}} key personnel</span>
      </div>
      {{#if team.leader}}
        <div class="mt-7">{{> team-profile team.leader featured=true}}</div>
      {{/if}}
      {{#if team.specialists.length}}
        <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {{#each team.specialists}}<li class="min-w-0">{{> team-profile this}}</li>{{/each}}
        </ul>
      {{/if}}
    </section>
  {{/if}}

  {{#if team.support.length}}
    <section aria-labelledby="support-team-heading" class="{{#if team.keyCount}}mt-12 border-t border-neutral-200 pt-10{{/if}}">
      <h2 id="support-team-heading" class="section-heading">{{page.supportHeading}}</h2>
      <ul class="mt-6 space-y-5">
        {{#each team.support}}<li class="min-w-0">{{> team-profile this support=true}}</li>{{/each}}
      </ul>
    </section>
  {{/if}}

  {{#unless team.total}}
    <p class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-neutral-700">{{page.emptyText}}</p>
  {{/unless}}

  {{#if page.moreNote}}
    <p class="mt-8 rounded-xl border border-neutral-200 bg-neutral-50 p-5 text-sm leading-relaxed text-neutral-700">{{page.moreNote}}</p>
  {{/if}}

  {{#if page.contactHeading}}
    <aside class="mt-12 flex flex-col gap-4 rounded-xl border border-blue-200 bg-blue-50 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-semibold text-brand-blue">{{page.contactHeading}}</h2>
        {{#if page.contactText}}<p class="mt-1 max-w-2xl text-sm leading-relaxed text-neutral-700">{{page.contactText}}</p>{{/if}}
      </div>
      <a href="/contact" class="btn btn-primary shrink-0">{{page.contactButtonLabel}} {{> icon name="arrow" class="h-4 w-4"}}</a>
    </aside>
  {{/if}}
</div>
