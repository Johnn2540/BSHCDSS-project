{{> page-hero title=album.title summary=album.description parentLabel="Pictures and Videos" parentHref="/gallery"}}

<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
  <p class="text-sm text-neutral-600">
    {{#if album.date}}{{formatDate album.date}} &middot; {{/if}}{{album.photos.length}} photo{{#unless (eq album.photos.length 1)}}s{{/unless}}
    {{#if album.activity}}{{#if album.activity.isPublished}} &middot; <a href="/activities/{{album.activity.slug}}" class="font-medium text-brand-blue underline-offset-2 hover:underline">{{album.activity.title}}</a>{{/if}}{{/if}}
  </p>

  {{#if album.photos.length}}
    {{#if (eq album.photos.length 1)}}
      {{#each album.photos}}
        <figure class="mx-auto mt-8 max-w-3xl overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm">
          <a href="{{img imageUrl "w_1600,c_limit"}}" class="block bg-neutral-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue">
            <img src="{{img imageUrl "w_960,c_limit"}}"
                 srcset="{{img imageUrl "w_480,c_limit"}} 480w, {{img imageUrl "w_768,c_limit"}} 768w, {{img imageUrl "w_1080,c_limit"}} 1080w"
                 sizes="(min-width: 832px) 768px, calc(100vw - 48px)"
                 alt="{{#if caption}}{{caption}}{{else}}Photo from {{../album.title}}{{/if}}"
                 {{#if width}}width="{{width}}"{{/if}} {{#if height}}height="{{height}}"{{/if}}
                 decoding="async" class="h-auto w-full" data-gallery-photo>
            <span class="sr-only"> (open full size)</span>
          </a>
          {{#if caption}}<figcaption class="border-t border-neutral-200 px-5 py-4 text-sm leading-relaxed text-neutral-700">{{caption}}</figcaption>{{/if}}
        </figure>
      {{/each}}
    {{else}}
    <ul class="mt-8 grid gap-6 sm:grid-cols-2">
      {{#each album.photos}}
        <li class="min-w-0{{#if isWide}} sm:col-span-2{{/if}}">
          <figure class="flex h-full flex-col overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm">
            <a href="{{img imageUrl "w_1600,c_limit"}}" class="flex {{#if isWide}}aspect-video{{else}}aspect-[4/3]{{/if}} items-center justify-center overflow-hidden bg-neutral-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue">
              <img src="{{#if isWide}}{{img imageUrl "w_1280,c_limit"}}{{else}}{{img imageUrl "w_768,c_limit"}}{{/if}}"
                   srcset="{{#if isWide}}{{img imageUrl "w_480,c_limit"}} 480w, {{img imageUrl "w_960,c_limit"}} 960w, {{img imageUrl "w_1280,c_limit"}} 1280w, {{img imageUrl "w_1600,c_limit"}} 1600w{{else}}{{img imageUrl "w_480,c_limit"}} 480w, {{img imageUrl "w_768,c_limit"}} 768w, {{img imageUrl "w_1080,c_limit"}} 1080w{{/if}}"
                   sizes="{{#if isWide}}(min-width: 1280px) 1230px, calc(100vw - 48px){{else}}(min-width: 1280px) 604px, (min-width: 640px) calc((100vw - 72px) / 2), calc(100vw - 32px){{/if}}"
                   alt="{{#if caption}}{{caption}}{{else}}Photo {{add @index 1}} from {{../album.title}}{{/if}}"
                   {{#if width}}width="{{width}}"{{/if}} {{#if height}}height="{{height}}"{{/if}}
                   loading="lazy" decoding="async" class="h-full w-full object-contain" data-gallery-photo>
              <span class="sr-only"> (open full size)</span>
            </a>
            {{#if caption}}<figcaption class="border-t border-neutral-200 px-5 py-4 text-sm leading-relaxed text-neutral-700">{{caption}}</figcaption>{{/if}}
          </figure>
        </li>
      {{/each}}
    </ul>
    {{/if}}
  {{else}}
    <p class="mt-6 text-neutral-700">Photos will be added to this album soon.</p>
  {{/if}}

  <a href="/gallery" class="mt-10 inline-flex items-center gap-2 font-semibold text-brand-blue underline-offset-4 hover:underline">&larr; Back to all albums and videos</a>
</div>
