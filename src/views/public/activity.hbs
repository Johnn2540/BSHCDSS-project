{{> page-hero title=activity.title summary=activity.summary parentLabel="Project Activities"}}
{{> section-hero-image image=heroImage}}

<div class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 sm:py-14 lg:grid-cols-[2fr_1fr]">
  <article class="min-w-0">
    <div data-motion="enter" data-motion-from="left">{{> prose text=activity.body}}</div>

    {{#if activity.externalUrl}}
      <div class="mt-8 rounded border border-brand-blue/20 bg-blue-50 p-6" data-motion="enter">
        <a href="{{activity.externalUrl}}" target="_blank" rel="noopener" class="btn btn-primary">
          Go to {{activity.title}} {{> icon name="external" class="h-4 w-4"}}<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <p class="mt-3 text-sm text-neutral-700">This opens an external website in a new tab.</p>
      </div>
    {{/if}}

    {{#if resourceDocuments.length}}
      <section aria-labelledby="training-resources-heading" class="mt-10">
        <h2 id="training-resources-heading" class="section-heading">Training resources</h2>
        <div class="mt-5">{{> document-list documents=resourceDocuments headingLevel="3"}}</div>
        <a href="/curriculum#document-library" class="action-link mt-4 inline-flex min-h-11 items-center gap-2">Browse all curriculum documents {{> icon name="arrow" class="h-4 w-4"}}</a>
      </section>
    {{/if}}

    {{#if albums.length}}
      <section aria-labelledby="albums-heading" class="mt-12">
        <h2 id="albums-heading" class="section-heading">Photos</h2>
        <div class="mt-6">{{> album-cards albums=albums}}</div>
      </section>
    {{/if}}

    {{#if videos.length}}
      <section aria-labelledby="videos-heading" class="mt-12">
        <h2 id="videos-heading" class="section-heading">Videos</h2>
        <div class="mt-6">{{> video-cards videos=videos}}</div>
      </section>
    {{/if}}
  </article>

  {{#if otherActivities.length}}
    <aside aria-labelledby="other-heading" class="self-start rounded border-l-4 border-brand-green bg-neutral-50 p-6" data-motion="enter" data-motion-from="right">
      <h2 id="other-heading" class="text-lg font-semibold text-brand-blue">Other project activities</h2>
      <ul class="mt-4 space-y-3">
        {{#each otherActivities}}
          <li><a href="/activities/{{slug}}" class="font-medium text-neutral-900 underline-offset-2 hover:text-brand-blue hover:underline">{{title}}</a></li>
        {{/each}}
        <li><a href="/curriculum" class="font-medium text-neutral-900 underline-offset-2 hover:text-brand-blue hover:underline">Curriculum Design and Development</a></li>
      </ul>
    </aside>
  {{/if}}
</div>
