{{!-- Banner: shared photo hero (partials/photo-hero.hbs) with quick Call / Email actions --}}
{{#> photo-hero image=heroImage title=page.title summary=page.summary titleId="contact-title" overlap=true actions=true}}
  {{!-- Inside a partial block, page data must be read through @root --}}
  {{#if @root.site.contact.phone}}
    <a href="tel:{{telHref @root.site.contact.phone}}" class="btn bg-white text-brand-blue-dark shadow-lg hover:bg-neutral-100 focus-visible:outline-white">
      {{> icon name="phone" class="h-5 w-5"}} Call {{@root.site.contact.phone}}
    </a>
  {{/if}}
  {{#if @root.site.contact.email}}
    <a href="mailto:{{@root.site.contact.email}}" class="btn border border-white/60 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20 focus-visible:outline-white">
      {{> icon name="mail" class="h-5 w-5"}} Email us
    </a>
  {{/if}}
{{/photo-hero}}

{{!-- ── Contact details: cards that overlap the bottom of the hero ──────────── --}}
<section aria-label="Contact details" class="relative z-10 mx-auto -mt-14 max-w-7xl px-4 sm:-mt-16 sm:px-6">
  <ul class="grid gap-3 sm:grid-cols-2 lg:gap-4 xl:grid-cols-4">
    {{#if site.contact.address.length}}
      <li class="contact-card">
        <span class="contact-card-icon">{{> icon name="pin" class="h-5 w-5"}}</span>
        <div class="min-w-0">
          <h2 class="contact-card-label">Visit us</h2>
          <address class="not-italic text-neutral-800">{{#each site.contact.address}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}</address>
        </div>
      </li>
    {{/if}}
    {{#if site.contact.phone}}
      <li class="contact-card">
        <span class="contact-card-icon">{{> icon name="phone" class="h-5 w-5"}}</span>
        <div class="min-w-0">
          <h2 class="contact-card-label">Call us</h2>
          <a href="tel:{{telHref site.contact.phone}}" class="font-medium text-neutral-900 hover:text-brand-blue hover:underline">{{site.contact.phone}}</a>
        </div>
      </li>
    {{/if}}
    {{#if site.contact.email}}
      <li class="contact-card">
        <span class="contact-card-icon">{{> icon name="mail" class="h-5 w-5"}}</span>
        <div class="min-w-0">
          <h2 class="contact-card-label">Email us</h2>
          <a href="mailto:{{site.contact.email}}" class="font-medium text-neutral-900 [overflow-wrap:anywhere] hover:text-brand-blue hover:underline">{{site.contact.email}}</a>
        </div>
      </li>
    {{/if}}
    {{#if site.contact.hours}}
      <li class="contact-card">
        <span class="contact-card-icon">{{> icon name="clock" class="h-5 w-5"}}</span>
        <div class="min-w-0">
          <h2 class="contact-card-label">Office hours</h2>
          <p class="text-neutral-800">{{site.contact.hours}}</p>
        </div>
      </li>
    {{/if}}
  </ul>
</section>

{{!-- ── Message form ─────────────────────────────────────────────────────────── --}}
<section aria-labelledby="form-heading" class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[2fr_3fr] lg:gap-16">
  <div>
    <h2 id="form-heading" class="section-heading">{{page.formHeading}}</h2>
    {{#if page.formIntro}}<div class="mt-6 text-neutral-700">{{> prose text=page.formIntro}}</div>{{/if}}
    <ul class="mt-8 space-y-3 text-sm text-neutral-700">
      <li class="flex items-start gap-3"><span class="mt-0.5 text-brand-green">{{> icon name="check" class="h-5 w-5"}}</span> Fields marked <span class="text-brand-red" aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.</li>
      <li class="flex items-start gap-3"><span class="mt-0.5 text-brand-green">{{> icon name="check" class="h-5 w-5"}}</span> We use your details only to reply to your message.</li>
    </ul>
  </div>

  <div class="rounded-lg border border-neutral-200 bg-white p-5 shadow-sm sm:p-8">
    {{> flash}}
    {{#if errors.form}}<div role="alert" class="mb-4 rounded border-l-4 border-brand-red bg-red-50 px-4 py-3 text-sm text-red-900">{{errors.form}}</div>{{/if}}

    <form method="post" action="/contact" novalidate class="space-y-5">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      {{!-- Honeypot: hidden from people, often filled in by spam bots --}}
      <div class="hidden" aria-hidden="true">
        <label for="website">Leave this field empty</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {{> admin/field name="name" label="Your name" type="text" required=true}}
        {{> admin/field name="email" label="Email address" type="email" required=true}}
      </div>
      {{> admin/field name="phone" label="Phone number (optional)" type="text"}}
      {{> admin/field name="subject" label="Subject" type="text" required=true}}
      {{> admin/field name="message" label="Message" type="textarea" rows=7 required=true}}

      <button type="submit" class="btn btn-primary w-full sm:w-auto">
        {{> icon name="mail" class="h-4 w-4"}} Send message
      </button>
    </form>
  </div>
</section>
