{{> page-hero title=page.title summary=page.summary}}

<div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1fr_2fr]">
  <aside aria-labelledby="details-heading">
    <h2 id="details-heading" class="text-xl font-bold text-brand-blue">Contact details</h2>
    <address class="mt-5 space-y-4 not-italic text-neutral-800">
      {{#if site.contact.address.length}}
        <p><span class="block text-sm font-semibold text-neutral-600">Address</span>{{#each site.contact.address}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}</p>
      {{/if}}
      {{#if site.contact.phone}}<p><span class="block text-sm font-semibold text-neutral-600">Phone</span>{{site.contact.phone}}</p>{{/if}}
      {{#if site.contact.email}}<p><span class="block text-sm font-semibold text-neutral-600">Email</span><a href="mailto:{{site.contact.email}}" class="text-brand-blue underline-offset-2 hover:underline">{{site.contact.email}}</a></p>{{/if}}
      {{#if site.contact.hours}}<p><span class="block text-sm font-semibold text-neutral-600">Office hours</span>{{site.contact.hours}}</p>{{/if}}
    </address>
  </aside>

  <section aria-labelledby="form-heading" class="rounded border border-neutral-200 border-t-4 border-t-brand-blue bg-white p-5 shadow-sm sm:p-8">
    <h2 id="form-heading" class="text-xl font-bold text-brand-blue">Send us a message</h2>
    <div class="mt-4">
      {{> flash}}
      {{#if errors.form}}<div role="alert" class="mb-4 rounded border-l-4 border-brand-red bg-red-50 px-4 py-3 text-sm text-red-900">{{errors.form}}</div>{{/if}}
    </div>

    <form method="post" action="/contact" novalidate class="space-y-5">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      {{!-- Honeypot: hidden from people, often filled in by spam bots --}}
      <div class="hidden" aria-hidden="true">
        <label for="website">Leave this field empty</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {{> admin/field name="name" label="Your name" type="text" required=true}}
        {{> admin/field name="email" label="Email address" type="email" required=true}}
      </div>
      {{> admin/field name="phone" label="Phone number (optional)" type="text"}}
      {{> admin/field name="subject" label="Subject" type="text" required=true}}
      {{> admin/field name="message" label="Message" type="textarea" rows=7 required=true}}

      <button type="submit" class="btn btn-primary">Send message</button>
      <p class="text-xs text-neutral-600">We use your details only to reply to your message.</p>
    </form>
  </section>
</div>
