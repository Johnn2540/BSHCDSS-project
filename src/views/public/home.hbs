{{!-- ══ 1. Banner ═══════════════════════════════════════════════════════════════
     Phone/tablet: the photo fills the banner behind the text (top shade into the black header,
     navy fade at the bottom), matching the About and Contact banners.
     Desktop (lg+): text on navy at left; the photo framed at right with a brand-colour accent and
     a floating "A project of the Ministry" badge. --}}
<section class="relative isolate overflow-hidden bg-brand-blue-dark text-white" aria-labelledby="home-title">
  <div class="hero-pattern pointer-events-none absolute inset-0 -z-10 hidden opacity-[0.06] lg:block" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl lg:grid lg:grid-cols-12 lg:items-center lg:gap-14 lg:px-6 lg:py-20 xl:py-24">
    {{!-- Photo --}}
    <div class="absolute inset-0 -z-20 lg:relative lg:inset-auto lg:z-0 lg:order-2 lg:col-span-5">
      <div class="relative h-full w-full lg:h-auto lg:aspect-[4/5]">
        <div class="pointer-events-none absolute -bottom-4 -right-4 hidden h-full w-full rounded-2xl border-2 border-brand-yellow/70 lg:block" aria-hidden="true"></div>
        <picture>
          <source type="image/webp" srcset="{{heroImage.srcset}}" sizes="(min-width: 1024px) 40vw, 100vw">
          <img src="{{heroImage.fallback}}" width="{{heroImage.width}}" height="{{heroImage.height}}" alt="{{heroImage.alt}}"
               fetchpriority="high" decoding="async"
               style="--pos: {{heroImage.position}}; --pos-lg: {{heroImage.positionLg}};"
               class="photo-hero-img absolute inset-0 h-full w-full object-cover lg:rounded-2xl lg:shadow-2xl lg:shadow-black/40">
        </picture>
        {{!-- Shades: phones/tablets only --}}
        <div class="photo-shade-top pointer-events-none absolute inset-x-0 top-0 h-40 lg:hidden" aria-hidden="true"></div>
        <div class="home-shade-bottom pointer-events-none absolute inset-0 lg:hidden" aria-hidden="true"></div>
        {{!-- Badge: desktop only --}}
        <div class="absolute -left-10 bottom-10 hidden max-w-[17rem] items-center gap-3 rounded-xl bg-white p-4 text-neutral-900 shadow-2xl lg:flex" data-motion="fade">
          <img src="{{#if site.brand}}{{site.brand.emblem.webp128}}{{else}}{{site.logoUrl}}{{/if}}" alt="" width="48" height="48" class="h-12 w-12 shrink-0 object-contain">
          <p class="text-sm leading-snug">
            <span class="block text-xs font-semibold uppercase tracking-wider text-brand-green">A project of the</span>
            <span class="font-semibold">{{site.ministry}}</span>
          </p>
        </div>
      </div>
    </div>

    {{!-- Text --}}
    <div class="relative flex min-h-[86svh] flex-col justify-end px-4 pb-12 pt-44 sm:px-6 sm:pb-16 lg:order-1 lg:col-span-7 lg:min-h-0 lg:p-0">
      {{#if page.eyebrow}}<p class="max-w-xl text-xs font-semibold uppercase tracking-[0.16em] text-brand-yellow sm:text-sm">{{page.eyebrow}}</p>{{/if}}
      <div class="mt-5 h-1 w-14 bg-brand-yellow" aria-hidden="true"></div>
      <h1 id="home-title" class="mt-5 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl xl:text-6xl" data-motion="enter">{{page.title}}</h1>
      {{#if page.summary}}<p class="mt-6 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg" data-motion="enter">{{page.summary}}</p>{{/if}}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {{#if page.primaryCtaLabel}}
          <a href="/about" class="btn bg-white px-6 text-brand-blue-dark shadow-lg hover:bg-neutral-100 focus-visible:outline-white">
            {{page.primaryCtaLabel}} {{> icon name="arrow" class="h-4 w-4"}}
          </a>
        {{/if}}
        {{#if page.secondaryCtaLabel}}
          <a href="{{activitiesHref}}" class="btn border border-white/60 bg-white/10 px-6 text-white backdrop-blur-sm hover:bg-white/20 focus-visible:outline-white">{{page.secondaryCtaLabel}}</a>
        {{/if}}
        {{> partner-button buttonClass="bg-brand-yellow px-6 text-black hover:bg-yellow-300 focus-visible:outline-white"}}
      </div>

      {{#if partners.length}}
        <div class="mt-12 hidden border-t border-white/15 pt-6 md:block">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/60">In partnership with</p>
          <ul class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-3">
            {{#each partners}}
              <li class="flex items-center gap-2.5">
                {{#if logoUrl}}<img src="{{img logoUrl "w_80,h_80,c_pad,b_white"}}" alt="" width="36" height="36" loading="lazy" class="h-9 w-9 rounded-full bg-white object-contain p-0.5">{{/if}}
                <span class="text-sm font-medium text-white/90">{{#if shortName}}{{shortName}}{{else}}{{name}}{{/if}}</span>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/if}}
    </div>
  </div>
</section>

{{!-- ══ 2. What the project does ══════════════════════════════════════════════ --}}
{{#if focusItems.length}}
  <section aria-labelledby="focus-heading">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="max-w-2xl">
        <h2 id="focus-heading" class="section-heading">{{page.focusHeading}}</h2>
        {{#if page.focusLead}}<p class="mt-4 text-neutral-700 sm:text-lg">{{page.focusLead}}</p>{{/if}}
      </div>
      <div class="mt-10">{{> focus-cards items=focusItems}}</div>
    </div>
  </section>
{{/if}}

{{!-- ══ 3. Why teacher training matters: sourced statistics (hidden when the list is empty) ══ --}}
{{#with (pairs page.stats) as |stats|}}{{#if stats.length}}
  <section aria-labelledby="stats-heading" class="bg-neutral-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="max-w-3xl">
        <h2 id="stats-heading" class="section-heading">{{@root.page.statsHeading}}</h2>
        {{#if @root.page.statsLead}}<p class="mt-4 text-neutral-700 sm:text-lg">{{@root.page.statsLead}}</p>{{/if}}
      </div>
      <dl class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 lg:gap-6">
        {{#each stats}}
          <div class="stat-card" data-motion="enter">
            {{#if label}}<dt class="text-3xl font-bold tracking-tight text-brand-blue sm:text-5xl">{{label}}</dt>{{/if}}
            <dd class="{{#if label}}mt-3 {{/if}}text-sm leading-snug text-neutral-700 sm:text-base">{{value}}</dd>
          </div>
        {{/each}}
      </dl>
      {{#if @root.page.statsSource}}<p class="mt-6 text-xs text-neutral-600">{{@root.page.statsSource}}</p>{{/if}}
    </div>
  </section>
{{/if}}{{/with}}

{{!-- ══ 4. About the project + objectives ═════════════════════════════════════ --}}
<section aria-labelledby="intro-heading">
  <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-7">
      <h2 id="intro-heading" class="section-heading">{{page.introHeading}}</h2>
      <div class="mt-8 space-y-5 text-base leading-relaxed text-neutral-800 sm:text-lg">
        {{#each (paragraphs page.body)}}
          {{#if @first}}
            <p class="max-w-prose text-xl font-medium leading-relaxed text-neutral-900 sm:text-[1.35rem]">{{this}}</p>
          {{else}}
            <p class="max-w-prose">{{this}}</p>
          {{/if}}
        {{/each}}
      </div>
      <a href="/about" class="btn btn-primary mt-8">Learn more about the project {{> icon name="arrow" class="h-4 w-4"}}</a>
    </div>

    {{#if page.objectives.length}}
      <aside aria-labelledby="objectives-heading" class="relative overflow-hidden rounded-xl bg-brand-blue-dark p-7 text-white shadow-xl sm:p-9 lg:col-span-5" data-motion="enter">
        <div class="pointer-events-none absolute inset-x-0 top-0 flex h-1.5" aria-hidden="true">
          <span class="flex-[6] bg-brand-green"></span><span class="flex-1 bg-brand-red"></span><span class="flex-1 bg-brand-yellow"></span>
        </div>
        <h3 id="objectives-heading" class="text-xl font-bold">{{page.objectivesHeading}}</h3>
        <ol class="mt-6 space-y-5">
          {{#each page.objectives}}
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-yellow text-sm font-bold text-black" aria-hidden="true">{{add @index 1}}</span>
              <span class="pt-1 leading-snug text-white/90">{{this}}</span>
            </li>
          {{/each}}
        </ol>
      </aside>
    {{/if}}
  </div>
</section>

{{!-- ══ 5. News and announcements (only when there are public announcements) ═══ --}}
{{#if announcements.length}}
  <section aria-labelledby="news-heading" class="bg-neutral-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 id="news-heading" class="section-heading">{{page.newsHeading}}</h2>
      {{!-- Columns adapt to how many announcements there are: 1 = one wide card, 2 = two, 3 = three --}}
      <ul class="mt-10 grid gap-6 {{#if (eq announcements.length 1)}}max-w-3xl{{else if (eq announcements.length 2)}}md:grid-cols-2{{else}}md:grid-cols-2 lg:grid-cols-3{{/if}}">
        {{#each announcements}}
          <li>
            <article class="flex h-full flex-col rounded-lg border border-neutral-200 bg-white p-6 shadow-sm" data-motion="enter">
              <p class="inline-flex items-center gap-2 text-sm font-medium text-brand-green">
                {{> icon name="megaphone" class="h-4 w-4"}} <time datetime="{{dateInput publishedAt}}">{{formatDate publishedAt}}</time>
              </p>
              <h3 class="mt-3 text-lg font-semibold leading-snug text-neutral-900">{{title}}</h3>
              <div class="mt-3 space-y-3 text-sm leading-relaxed text-neutral-700">
                {{#each (paragraphs body)}}<p>{{this}}</p>{{/each}}
              </div>
            </article>
          </li>
        {{/each}}
      </ul>
    </div>
  </section>
{{/if}}

{{!-- ══ 6. From the gallery ════════════════════════════════════════════════════ --}}
<section aria-labelledby="gallery-heading" class="{{#unless announcements.length}}bg-neutral-50{{/unless}}">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    {{#if albums.length}}
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="gallery-heading" class="section-heading">{{page.galleryHeading}}</h2>
          {{#if page.galleryLead}}<p class="mt-4 text-neutral-700 sm:text-lg">{{page.galleryLead}}</p>{{/if}}
        </div>
        <a href="/gallery" class="btn btn-primary shrink-0 self-start sm:self-auto">
          {{> icon name="camera" class="h-4 w-4"}} Visit the gallery{{#if videoCount}} and videos{{/if}}
        </a>
      </div>
      <div class="mt-10">{{> album-cards albums=albums}}</div>
    {{else}}
      {{!-- No albums yet: a call-out to the gallery page --}}
      <div class="flex flex-col gap-6 rounded-xl bg-brand-green p-8 text-white sm:flex-row sm:items-center sm:justify-between sm:p-10">
        <div class="flex items-start gap-5">
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white/15 text-brand-yellow">{{> icon name="camera" class="h-7 w-7"}}</span>
          <div>
            <h2 id="gallery-heading" class="text-2xl font-bold">{{page.galleryHeading}}</h2>
            {{#if page.galleryLead}}<p class="mt-2 max-w-2xl leading-relaxed text-white/90">{{page.galleryLead}}</p>{{/if}}
          </div>
        </div>
        <a href="/gallery" class="btn btn-light shrink-0 self-start sm:self-auto">Visit the gallery</a>
      </div>
    {{/if}}
  </div>
</section>

{{!-- ══ 7. Get in touch ══════════════════════════════════════════════════════════ --}}
<section aria-labelledby="contact-heading" class="relative overflow-hidden bg-brand-blue-dark text-white">
  <div class="hero-pattern pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true"></div>
  <div class="relative mx-auto flex max-w-7xl flex-col gap-8 px-4 py-14 sm:px-6 sm:py-16 lg:flex-row lg:items-center lg:justify-between" data-motion="enter">
    <div class="flex items-start gap-5">
      <span class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-yellow sm:flex">{{> icon name="mail" class="h-7 w-7"}}</span>
      <div>
        <h2 id="contact-heading" class="text-2xl font-bold sm:text-3xl">{{page.contactHeading}}</h2>
        {{#if page.contactLead}}<p class="mt-2 max-w-xl text-white/85">{{page.contactLead}}</p>{{/if}}
      </div>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <a href="/contact" class="btn bg-brand-yellow px-6 text-black hover:bg-yellow-300 focus-visible:outline-white">Contact us</a>
      {{#if site.contact.email}}
        <a href="mailto:{{site.contact.email}}" class="btn btn-outline-light px-6 [overflow-wrap:anywhere]">{{> icon name="mail" class="h-4 w-4 shrink-0"}} {{site.contact.email}}</a>
      {{/if}}
    </div>
  </div>
</section>
