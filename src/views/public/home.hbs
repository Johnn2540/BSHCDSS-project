{{!-- Hero --}}
<section class="relative overflow-hidden bg-brand-blue text-white">
  <div class="hero-pattern pointer-events-none absolute inset-0 opacity-10" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[1fr_auto]">
    <div class="max-w-3xl">
      {{#if page.eyebrow}}<p class="text-sm font-semibold uppercase tracking-wider text-brand-yellow">{{page.eyebrow}}</p>{{/if}}
      <h1 class="mt-3 text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">{{page.title}}</h1>
      {{#if page.summary}}<p class="mt-5 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg">{{page.summary}}</p>{{/if}}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        {{#if page.primaryCtaLabel}}<a href="/about" class="btn btn-light">{{page.primaryCtaLabel}}</a>{{/if}}
        {{#if page.secondaryCtaLabel}}<a href="{{activitiesHref}}" class="btn btn-outline-light">{{page.secondaryCtaLabel}}</a>{{/if}}
      </div>
    </div>
    <div class="hidden lg:block">
      {{!-- The seal already has its own white and gold ring, so it needs no extra frame. --}}
      <img src="{{#if site.brand}}{{site.brand.emblem.webp512}}{{else}}{{site.logoUrl}}{{/if}}" alt="" width="256" height="256"
           class="h-64 w-64 rounded-full object-contain shadow-2xl ring-8 ring-white/10">
    </div>
  </div>
</section>

{{!-- About intro --}}
<section aria-labelledby="intro-heading" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
  <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-16">
    <div>
      <h2 id="intro-heading" class="section-heading">{{page.introHeading}}</h2>
      <div class="mt-6 space-y-4 text-base leading-relaxed text-neutral-700 sm:text-lg">
        {{#each (paragraphs page.body)}}<p>{{this}}</p>{{/each}}
      </div>
      <a href="/about" class="mt-6 inline-flex items-center gap-2 font-semibold text-brand-blue underline-offset-4 hover:underline">
        Learn more about the project {{> icon name="arrow" class="h-4 w-4"}}
      </a>
    </div>

    {{#if page.objectives.length}}
      <aside aria-labelledby="objectives-heading" class="rounded border-l-4 border-brand-green bg-neutral-50 p-6 sm:p-8">
        <h3 id="objectives-heading" class="text-lg font-semibold text-brand-blue">{{page.objectivesHeading}}</h3>
        <ul class="mt-4 space-y-3">
          {{#each page.objectives}}
            <li class="flex gap-3 text-neutral-800">
              <span class="mt-0.5 text-brand-green">{{> icon name="check" class="h-5 w-5"}}</span>
              <span>{{this}}</span>
            </li>
          {{/each}}
        </ul>
      </aside>
    {{/if}}
  </div>
</section>

{{!-- Focus areas: Curriculum + published activities --}}
<section aria-labelledby="focus-heading" class="bg-neutral-50">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
    <div class="max-w-2xl">
      <h2 id="focus-heading" class="section-heading">{{page.focusHeading}}</h2>
      {{#if page.focusLead}}<p class="mt-4 text-neutral-700 sm:text-lg">{{page.focusLead}}</p>{{/if}}
    </div>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {{#each focusItems}}
        <li>
          <a href="{{href}}" class="group flex h-full flex-col rounded border border-neutral-200 border-t-4 border-t-brand-green bg-white p-6 shadow-sm transition hover:border-t-brand-blue hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand-blue/10 text-brand-blue">
              {{> icon name=icon class="h-6 w-6"}}
            </span>
            <h3 class="mt-5 text-lg font-semibold leading-snug text-neutral-900 group-hover:text-brand-blue">{{title}}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-700">{{summary}}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue">
              Read more<span class="sr-only"> about {{title}}</span> {{> icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-0.5"}}
            </span>
          </a>
        </li>
      {{/each}}
    </ul>
  </div>
</section>

{{!-- Gallery + contact call-outs --}}
<section class="mx-auto grid max-w-7xl gap-6 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-2">
  <div class="flex flex-col rounded bg-brand-green p-8 text-white sm:p-10">
    {{> icon name="camera" class="h-8 w-8 text-brand-yellow"}}
    <h2 class="mt-4 text-2xl font-bold">{{page.galleryHeading}}</h2>
    <p class="mt-3 flex-1 leading-relaxed text-white/90">{{page.galleryLead}}</p>
    <a href="/gallery" class="btn btn-light mt-6 self-start">Visit the gallery</a>
  </div>
  <div class="flex flex-col rounded border border-neutral-200 p-8 sm:p-10">
    <h2 class="text-2xl font-bold text-brand-blue">{{page.contactHeading}}</h2>
    <p class="mt-3 flex-1 leading-relaxed text-neutral-700">{{page.contactLead}}</p>
    {{#if site.contact.email}}
      <p class="mt-4 text-sm text-neutral-700">Email: <a href="mailto:{{site.contact.email}}" class="font-semibold text-brand-blue underline-offset-2 hover:underline">{{site.contact.email}}</a></p>
    {{/if}}
    <a href="/contact" class="btn btn-primary mt-6 self-start">Contact us</a>
  </div>
</section>
