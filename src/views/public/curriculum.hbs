{{> page-hero title=page.title summary=page.summary}}

<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
  {{#if page.body}}
    <article class="max-w-3xl">{{> prose text=page.body}}</article>
  {{/if}}

  <section aria-labelledby="docs-heading" class="mt-12">
    <h2 id="docs-heading" class="section-heading">Curriculum documents</h2>
    {{#if documentGroups.length}}
      {{#each documentGroups}}
        <div class="mt-8">
          <h3 class="text-lg font-semibold text-neutral-900">{{category}}</h3>
          <ul class="mt-3 divide-y divide-neutral-200 rounded border border-neutral-200 bg-white">
            {{#each documents}}
              <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="font-medium text-neutral-900">{{title}}</p>
                  {{#if description}}<p class="mt-1 text-sm text-neutral-600">{{description}}</p>{{/if}}
                </div>
                <a href="/documents/{{id}}/download" class="btn btn-primary shrink-0 py-2" rel="nofollow">
                  Download<span class="sr-only"> {{title}}</span>
                  <span class="text-xs font-normal text-white/80">({{fileExt fileName}}{{#if fileSize}}, {{formatBytes fileSize}}{{/if}})</span>
                </a>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/each}}
    {{else}}
      <p class="mt-6 text-neutral-700">Curriculum documents will be published here soon.</p>
    {{/if}}

    <p class="mt-8 rounded border-l-4 border-brand-blue bg-blue-50 px-4 py-3 text-sm text-neutral-800">
      Registered tutors can <a href="/login" class="font-semibold text-brand-blue underline">log in</a> to access additional curriculum documents.
    </p>
  </section>
</div>
