<section class="curriculum-hero">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
    <nav aria-label="Breadcrumb" class="mb-7 text-sm text-blue-100">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-yellow">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">Curriculum</li>
      </ol>
    </nav>
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
      <div>
        {{#if page.eyebrow}}<p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-100">{{page.eyebrow}}</p>{{/if}}
        <h1 class="mt-3 max-w-3xl text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">{{page.title}}</h1>
        {{#if page.summary}}<p class="mt-5 max-w-2xl text-base leading-relaxed text-blue-100 sm:text-lg">{{page.summary}}</p>{{/if}}
        <a href="#document-library" class="btn btn-light mt-7">{{page.browseLabel}} {{> icon name="arrow" class="h-4 w-4"}}</a>
      </div>
      {{#if library.total}}
        <div class="curriculum-hero-panel">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-white">{{> icon name="book" class="h-7 w-7"}}</span>
          <p class="mt-4 text-sm font-medium text-blue-100">{{page.libraryHeading}}</p>
          <p class="mt-2 flex items-baseline gap-3"><span class="text-5xl font-bold tracking-tight text-white">{{library.total}}</span><span class="text-sm text-blue-100">document{{#unless (eq library.total 1)}}s{{/unless}}</span></p>
          <p class="mt-4 border-t border-white/20 pt-4 text-sm text-blue-100">{{library.categoryCount}} subject area{{#unless (eq library.categoryCount 1)}}s{{/unless}} · Downloadable resources</p>
        </div>
      {{/if}}
    </div>
  </div>
</section>

<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
  {{> document-library library=library page=page action="/curriculum"}}

  {{#if page.body}}
    <section aria-labelledby="curriculum-overview-heading" class="curriculum-overview mt-14">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-green-dark">{{page.overviewEyebrow}}</p>
        <h2 id="curriculum-overview-heading" class="mt-3 text-2xl font-bold text-brand-blue">{{page.overviewHeading}}</h2>
      </div>
      <article class="min-w-0">{{> prose text=page.body}}</article>
    </section>
  {{/if}}

  {{#unless currentUser}}
    {{#if page.tutorIntro}}
      <aside class="mt-10 flex flex-col gap-4 rounded-lg border border-blue-200 bg-blue-50 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div class="flex items-start gap-3">
          {{> icon name="users" class="mt-0.5 h-6 w-6 shrink-0 text-brand-blue"}}
          <div><h2 class="font-semibold text-brand-blue">{{page.tutorHeading}}</h2><p class="mt-1 text-sm leading-relaxed text-neutral-700">{{page.tutorIntro}}</p></div>
        </div>
        <a href="/login" class="btn btn-primary shrink-0">Tutor login {{> icon name="arrow" class="h-4 w-4"}}</a>
      </aside>
    {{/if}}
  {{/unless}}
</div>
