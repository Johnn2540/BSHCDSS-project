<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{> seo-head}}
  <meta name="theme-color" content="#000000">
  {{> head-icons}}
  {{#if isHome}}{{#if site.brand}}
    {{!-- Start fetching the header logo immediately on the home page --}}
    <link rel="preload" as="image" type="image/webp" href="{{site.brand.lockup.webp640}}"
          imagesrcset="{{site.brand.lockup.webp640}} 640w, {{site.brand.lockup.webp1280}} 1280w"
          imagesizes="(min-width: 1280px) 301px, (min-width: 1024px) 258px, (min-width: 640px) 172px, 150px">
  {{/if}}{{/if}}
  {{!-- Swap no-js for js before first paint. The nonce lets it pass the CSP. --}}
  <script nonce="{{cspNonce}}">document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  {{!-- Version changed assets so returning visitors receive the current styles and menu integration. --}}
  <link rel="stylesheet" href="/css/style.css?v=team-contacts-1">
  <script src="/js/site.js?v=public-notifications-1" defer></script>
  <script src="/js/notifications.js" defer></script>
  <script src="/js/motion.js" defer></script>
</head>
<body class="flex min-h-screen flex-col bg-white text-neutral-900 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand-yellow focus:px-4 focus:py-2 focus:font-semibold focus:text-black">Skip to main content</a>

  {{> site-header}}

  <main id="main" class="flex-1" tabindex="-1">
    {{{body}}}
  </main>

  {{> site-footer}}
</body>
</html>
