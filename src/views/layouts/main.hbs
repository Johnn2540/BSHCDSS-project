<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if title}}{{title}} | {{site.shortName}}{{else}}{{site.shortName}} | {{site.fullName}}{{/if}}</title>
  <meta name="description" content="{{truncate (either metaDescription site.tagline) 160}}">
  {{#if noindex}}
    <meta name="robots" content="noindex">
  {{else}}
    <link rel="canonical" href="{{canonicalUrl}}">
  {{/if}}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{site.shortName}}">
  <meta property="og:locale" content="en_GB">
  <meta property="og:title" content="{{either title site.fullName}}">
  <meta property="og:description" content="{{truncate (either metaDescription site.tagline) 200}}">
  <meta property="og:url" content="{{canonicalUrl}}">
  {{#if metaImage}}
    <meta property="og:image" content="{{absoluteUrl (img metaImage "w_1200,h_630,c_fill") baseUrl}}">
    <meta name="twitter:card" content="summary_large_image">
  {{else if site.brand}}
    {{!-- Default share image: the full logo on black at the 1200x630 size social apps expect --}}
    <meta property="og:image" content="{{absoluteUrl site.brand.ogImage baseUrl}}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{site.shortName}}: {{site.fullName}}">
    <meta name="twitter:card" content="summary_large_image">
  {{else}}
    <meta property="og:image" content="{{absoluteUrl site.logoUrl baseUrl}}">
    <meta name="twitter:card" content="summary">
  {{/if}}
  <meta name="theme-color" content="#000000">
  {{> head-icons}}
  {{#if isHome}}{{#if site.brand}}
    {{!-- Start fetching the header logo immediately on the home page --}}
    <link rel="preload" as="image" type="image/webp" href="{{site.brand.lockup.webp640}}"
          imagesrcset="{{site.brand.lockup.webp640}} 640w, {{site.brand.lockup.webp1280}} 1280w"
          imagesizes="(min-width: 1280px) 301px, (min-width: 1024px) 258px, (min-width: 640px) 172px, 150px">
  {{/if}}{{/if}}
  {{!-- Swap no-js for js before first paint. The nonce lets it pass the CSP. --}}
  <script nonce="{{cspNonce}}">document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/site.js" defer></script>
</head>
<body class="flex min-h-screen flex-col bg-white text-neutral-900 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand-yellow focus:px-4 focus:py-2 focus:font-semibold focus:text-black">Skip to main content</a>

  {{> site-header}}

  <main id="main" class="flex-1" tabindex="-1">
    {{{body}}}
  </main>

  {{> site-footer}}
</body>
</html>
