{{!-- Opens the sidebar menu on phones and tablets. Param: dark (true on the black identity band) --}}
<button type="button" data-drawer-open aria-controls="site-drawer" aria-expanded="false" aria-haspopup="dialog"
        class="hamburger {{#if dark}}hamburger-dark{{else}}hamburger-light{{/if}} xl:hidden">
  <span class="sr-only">Open menu</span>
  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M4 7h16M4 12h16M4 17h16"/>
  </svg>
</button>
