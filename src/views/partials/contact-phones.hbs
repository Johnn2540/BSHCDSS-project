<div class="min-w-0">
  <ul>
    {{#if contact.phone}}
      <li><a href="tel:{{telHref contact.phone}}" class="inline-flex min-h-8 items-center {{linkClass}}"><span class="sr-only">Phone: </span>{{contact.phone}}</a></li>
    {{/if}}
    {{#if contact.secondaryPhone}}
      <li><a href="tel:{{telHref contact.secondaryPhone}}" class="inline-flex min-h-8 items-center {{linkClass}}"><span class="sr-only">Alternative phone: </span>{{contact.secondaryPhone}}</a></li>
    {{/if}}
  </ul>
</div>
