{{!-- Professional cards with images: Curriculum + each published activity.
     Desktop (lg+): image at top (16:9), fixed height, icon + title + summary below.
     Mobile/tablet: image visible, click to expand into modal with large hero image.
     Param: items [{ icon, title, summary, href, imageUrl, imageAlt }] --}}
<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {{#each items}}
    <li data-motion="enter">
      <a href="{{href}}" class="focus-card group relative flex h-full flex-col overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm transition-all hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue lg:border-t-4 lg:border-t-brand-green lg:hover:border-t-brand-blue">
        {{!-- Image container: responsive 16:9 aspect ratio --}}
        {{#if imageUrl}}
          <div class="relative aspect-video w-full overflow-hidden bg-neutral-100">
            <img src="{{img imageUrl 'c_fill,g_auto,w_600'}}"
                 srcset="{{img imageUrl 'c_fill,g_auto,w_400'}} 400w, {{img imageUrl 'c_fill,g_auto,w_600'}} 600w, {{img imageUrl 'c_fill,g_auto,w_800'}} 800w"
                 sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                 alt="{{imageAlt}}"
                 loading="lazy" decoding="async"
                 class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105">
          </div>
        {{/if}}
        {{!-- Content: icon, title, summary, CTA --}}
        <div class="flex flex-1 flex-col p-5 sm:p-6">
          {{!-- Icon --}}
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full {{#if imageUrl}}bg-brand-blue/15 text-brand-blue{{else}}bg-brand-blue/10 text-brand-blue{{/if}}">
            {{> icon name=icon class="h-5 w-5"}}
          </span>
          {{!-- Title --}}
          <h3 class="mt-4 text-lg font-semibold leading-snug text-neutral-900 group-hover:text-brand-blue">{{title}}</h3>
          {{!-- Summary --}}
          <p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-700">{{summary}}</p>
          {{!-- CTA --}}
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue transition-colors group-hover:text-brand-green">
            Read more<span class="sr-only"> about {{title}}</span>
            {{> icon name="arrow" class="motion-arrow h-4 w-4 transition-transform group-hover:translate-x-1"}}
          </span>
        </div>
      </a>
    </li>
  {{/each}}
</ul>
