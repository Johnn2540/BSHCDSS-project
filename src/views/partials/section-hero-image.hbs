{{!-- Photo at the top of a section page (activities, curriculum): the same picture as its home page card.
     Phone: edge to edge at 16:9. Tablet and up: contained, rounded and wider. Param: image (see coverImage). --}}
{{#if image}}
  <figure class="mx-auto max-w-7xl sm:px-6 sm:pt-8" data-motion="fade">
    <div class="relative aspect-video overflow-hidden bg-brand-blue-dark sm:aspect-[2/1] sm:rounded-lg sm:shadow-lg lg:aspect-[21/9]">
      <img src="{{image.src}}"{{#if image.srcset}} srcset="{{image.srcset}}" sizes="(min-width: 1280px) 1216px, 100vw"{{/if}}
           width="{{image.width}}" height="{{image.height}}" alt="{{image.alt}}" fetchpriority="high" decoding="async"
           style="object-position: {{image.position}};" class="h-full w-full object-cover">
      <div class="absolute inset-x-0 bottom-0 flex h-1.5" aria-hidden="true">
        <span class="flex-[6] bg-brand-green"></span><span class="flex-1 bg-brand-yellow"></span><span class="flex-1 bg-brand-red"></span>
      </div>
    </div>
  </figure>
{{/if}}
