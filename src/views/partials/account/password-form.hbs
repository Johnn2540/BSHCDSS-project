<form method="post" action="{{passwordAction}}" novalidate class="admin-card max-w-2xl space-y-6 p-5 sm:p-8">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  {{!-- Lets password managers know which account the new password belongs to --}}
  <input type="text" name="username" value="{{currentUser.email}}" autocomplete="username" readonly hidden>

  {{#each (passwordFields minLength)}}
    <div>
      <label for="{{id}}" class="form-label">{{label}} <span class="text-brand-red" aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
      {{#if help}}<p id="{{id}}-help" class="form-help">{{help}}</p>{{/if}}
      <div class="relative mt-1.5">
        <input id="{{id}}" name="{{name}}" type="password" autocomplete="{{autocomplete}}" required
               {{#if (eq name "currentPassword")}}{{else}}minlength="{{../minLength}}" maxlength="72"{{/if}}
               class="form-input mt-0! pr-20"
               {{#if (get @root.errors name)}}aria-invalid="true" aria-describedby="{{id}}-error"{{else}}{{#if help}}aria-describedby="{{id}}-help"{{/if}}{{/if}}>
        <button type="button" class="password-toggle absolute inset-y-0 right-0 px-3 text-sm font-semibold text-brand-blue hover:underline"
                data-password-toggle="{{id}}" aria-controls="{{id}}" aria-pressed="false" hidden>Show</button>
      </div>
      {{#if (get @root.errors name)}}<p id="{{id}}-error" class="form-error">{{get @root.errors name}}</p>{{/if}}
    </div>
  {{/each}}

  <div class="flex flex-wrap gap-3 border-t border-neutral-200 pt-6">
    <button type="submit" class="btn btn-primary">Change password</button>
    <a href="{{passwordCancel}}" class="btn border border-neutral-300 bg-white text-neutral-800 hover:bg-neutral-50 focus-visible:outline-brand-blue">Cancel</a>
  </div>
</form>

<p class="mt-4 max-w-2xl text-sm text-neutral-600">
  Tip: a short sentence of four or five unrelated words is long, strong and easier to remember than a jumble of symbols.
</p>
