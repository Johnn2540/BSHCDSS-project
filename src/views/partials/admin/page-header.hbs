{{!-- Params: title, intro, back (url), backLabel; block content goes on the right (actions) --}}
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="min-w-0">
    {{#if back}}<a href="{{back}}" class="text-sm font-semibold text-brand-blue underline-offset-2 hover:underline">&larr; {{backLabel}}</a>{{/if}}
    <h1 class="mt-1 text-2xl font-bold text-brand-blue sm:text-3xl">{{title}}</h1>
    {{#if intro}}<p class="mt-1 max-w-3xl text-sm text-neutral-700">{{intro}}</p>{{/if}}
  </div>
  {{#if @partial-block}}<div class="flex shrink-0 flex-wrap gap-2">{{> @partial-block}}</div>{{/if}}
</div>
