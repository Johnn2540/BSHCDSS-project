<ul class="document-list">
  {{#each documents}}
    <li class="document-row">
      <div class="document-file-icon">{{> icon name="page" class="h-6 w-6"}}</div>
      <div class="min-w-0 flex-1">
        <h{{../headingLevel}} class="text-base font-semibold leading-snug text-neutral-900 sm:text-lg">{{title}}</h{{../headingLevel}}>
        {{#if description}}<p class="mt-2 max-w-3xl text-sm leading-relaxed text-neutral-600">{{description}}</p>{{/if}}
        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-600">
          <span class="font-semibold text-brand-blue">{{fileExt fileName}}</span>
          {{#if (or (eq (fileExt fileName) "DOC") (eq (fileExt fileName) "DOCX"))}}<span>Word document</span>{{/if}}
          {{#if fileSize}}<span>{{formatBytes fileSize}}</span>{{/if}}
          {{#if ../showAudience}}<span class="badge {{#if (eq audience "TUTORS")}}badge-green{{else}}badge-grey{{/if}}">{{enumLabel audience}}</span>{{/if}}
        </p>
      </div>
      <a href="/documents/{{id}}/download" class="document-download" rel="nofollow">
        {{> icon name="download" class="h-4 w-4"}}
        Download<span class="sr-only"> {{title}} ({{fileExt fileName}}{{#if fileSize}}, {{formatBytes fileSize}}{{/if}})</span>
      </a>
    </li>
  {{/each}}
</ul>
