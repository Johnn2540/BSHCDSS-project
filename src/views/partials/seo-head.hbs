<title>{{#if seo}}{{seo.title}}{{else}}{{#if title}}{{title}} | {{site.shortName}}{{else}}{{site.shortName}} | {{site.fullName}}{{/if}}{{/if}}</title>
<meta name="description" content="{{#if seo}}{{seo.description}}{{else}}{{truncate (either metaDescription site.tagline) 200}}{{/if}}">
{{#if noindex}}
  <meta name="robots" content="{{either robotsPolicy "noindex, nofollow"}}">
{{else}}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <link rel="canonical" href="{{#if seo}}{{seo.canonical}}{{else}}{{canonicalUrl}}{{/if}}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{site.shortName}}">
  <meta property="og:locale" content="en_GB">
  <meta property="og:title" content="{{#if seo}}{{seo.title}}{{else}}{{either title site.fullName}}{{/if}}">
  <meta property="og:description" content="{{#if seo}}{{seo.description}}{{else}}{{truncate (either metaDescription site.tagline) 200}}{{/if}}">
  <meta property="og:url" content="{{#if seo}}{{seo.canonical}}{{else}}{{canonicalUrl}}{{/if}}">
  {{#if seo.image}}
    <meta property="og:image" content="{{seo.image}}">
    <meta property="og:image:alt" content="{{seo.imageAlt}}">
    {{#if seo.imageWidth}}<meta property="og:image:width" content="{{seo.imageWidth}}">{{/if}}
    {{#if seo.imageHeight}}<meta property="og:image:height" content="{{seo.imageHeight}}">{{/if}}
  {{/if}}
  <meta name="twitter:card" content="{{either seo.card "summary"}}">
  <meta name="twitter:title" content="{{#if seo}}{{seo.title}}{{else}}{{either title site.fullName}}{{/if}}">
  <meta name="twitter:description" content="{{#if seo}}{{seo.description}}{{else}}{{truncate (either metaDescription site.tagline) 200}}{{/if}}">
  {{#if seo.image}}
    <meta name="twitter:image" content="{{seo.image}}">
    <meta name="twitter:image:alt" content="{{seo.imageAlt}}">
  {{/if}}
  {{#if seo.structuredData}}<script type="application/ld+json" nonce="{{cspNonce}}">{{{seo.structuredData}}}</script>{{/if}}
{{/if}}
{{#if site.googleSiteVerification}}<meta name="google-site-verification" content="{{site.googleSiteVerification}}">{{/if}}
