<aside id="portal-navigation" class="portal-sidebar" data-portal-sidebar>
  <div class="portal-sidebar-head">
    <h2 id="portal-menu-title" class="text-sm font-bold text-neutral-900">Tutor Portal</h2>
    <button type="button" class="portal-close" data-portal-close aria-label="Close Tutor Portal menu">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="portal-sidebar-scroll">
    <p class="portal-nav-label">Workspace</p>
    <nav aria-label="Tutor Portal" data-tutor-nav>
      <ul class="space-y-1">
        {{#each tutorNavigation}}
          <li><a href="{{href}}" class="portal-nav-link {{#if active}}is-current{{/if}}" {{#if active}}aria-current="page"{{/if}}>
            {{> icon name=icon class="h-5 w-5 shrink-0"}}<span>{{label}}</span>
          </a></li>
        {{/each}}
      </ul>
    </nav>
    <div class="mt-7 border-t border-neutral-200 pt-5">
      <p class="portal-nav-label">Account</p>
      <a href="/tutor/password" class="portal-nav-link {{#if (eq currentPath "/tutor/password")}}is-current{{/if}}" {{#if (eq currentPath "/tutor/password")}}aria-current="page"{{/if}}>
        {{> icon name="lock" class="h-5 w-5 shrink-0"}} Change password
      </a>
      <a href="mailto:{{site.contact.email}}" class="portal-nav-link">{{> icon name="mail" class="h-5 w-5 shrink-0"}} Project support</a>
    </div>
  </div>
  <div class="portal-sidebar-account">
    <div class="flex min-w-0 items-start gap-3">
      <span class="portal-avatar shrink-0" aria-hidden="true">{{> icon name="person" class="h-5 w-5"}}</span>
      <div class="min-w-0"><p class="text-sm font-semibold text-neutral-900">{{currentUser.name}}</p><p class="mt-1 break-all text-xs leading-relaxed text-neutral-600">{{currentUser.email}}</p><p class="mt-2 text-xs font-semibold text-brand-green-dark">{{#if (eq currentUser.role "ADMIN")}}Administrator preview{{else}}Tutor account{{/if}}</p></div>
    </div>
    <form method="post" action="/logout" class="mt-4">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <button type="submit" class="portal-logout">{{> icon name="logout" class="h-4 w-4"}} Log out</button>
    </form>
  </div>
</aside>
