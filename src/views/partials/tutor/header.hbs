<div class="portal-page-heading">
  <div class="min-w-0" data-motion="fade">
    {{#if overview}}
      <p class="text-sm font-medium text-neutral-600">Welcome, <span class="font-semibold text-neutral-900">{{currentUser.name}}</span></p>
    {{else}}
      <nav aria-label="Breadcrumb" class="text-xs font-medium text-neutral-600"><a href="/tutor" class="hover:text-brand-blue hover:underline">Overview</a> <span aria-hidden="true" class="mx-2">/</span> <span aria-current="page">{{either title page.title}}</span></nav>
    {{/if}}
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">{{either title page.title}}</h1>
    {{#if (either summary page.summary)}}<p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base">{{either summary page.summary}}</p>{{/if}}
  </div>
  {{#if overview}}<p class="portal-library-count">{{> icon name="book" class="h-4 w-4"}} {{totalFiles}} published file{{#unless (eq totalFiles 1)}}s{{/unless}}</p>{{/if}}
</div>
