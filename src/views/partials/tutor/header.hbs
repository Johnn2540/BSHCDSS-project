{{> flash}}
<div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
  <div class="min-w-0" data-motion="fade">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-green-dark">Tutor Portal</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-blue sm:text-4xl">{{page.title}}</h1>
    {{#if page.summary}}<p class="mt-3 max-w-2xl leading-relaxed text-neutral-600">{{page.summary}}</p>{{/if}}
  </div>
  <div class="shrink-0 text-sm sm:text-right">
    <p class="font-semibold text-neutral-900">{{currentUser.name}}</p>
    <p class="mt-1 break-all text-xs text-neutral-600">{{currentUser.email}}</p>
    <div class="mt-3 flex flex-wrap items-center gap-4 sm:justify-end">
      <a href="/tutor/password" class="action-link">Change password</a>
      {{> logout-form}}
    </div>
  </div>
</div>
<nav aria-label="Tutor Portal" class="mt-8 grid grid-cols-2 gap-2 rounded-xl border border-neutral-200 bg-neutral-50 p-2 sm:flex sm:flex-wrap" data-tutor-nav>
  {{#each tutorNavigation}}
    <a href="{{href}}" class="tutor-nav-link {{#if active}}is-current{{/if}}" {{#if active}}aria-current="page"{{/if}}>{{label}}</a>
  {{/each}}
</nav>
