{{!-- Page heading band with breadcrumb: navy with the tricolour rule, matching the photo banners (About, Contact) and the
     Curriculum banner. Params: title, summary, parentLabel, parentHref --}}
<section class="relative isolate overflow-hidden bg-brand-blue-dark text-white">
  <div class="hero-pattern pointer-events-none absolute inset-0 -z-10 opacity-[0.06]" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-8 sm:px-6 sm:pb-14 sm:pt-12" data-motion="enter">
    <nav aria-label="Breadcrumb" class="text-sm text-white/75">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="underline-offset-2 hover:text-white hover:underline">Home</a></li>
        {{#if parentLabel}}
          <li aria-hidden="true">/</li>
          <li>{{#if parentHref}}<a href="{{parentHref}}" class="underline-offset-2 hover:text-white hover:underline">{{parentLabel}}</a>{{else}}{{parentLabel}}{{/if}}</li>
        {{/if}}
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-white">{{title}}</li>
      </ol>
    </nav>
    <div class="mt-5 h-1 w-14 bg-brand-yellow" aria-hidden="true"></div>
    <h1 class="mt-5 text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">{{title}}</h1>
    {{#if summary}}<p class="mt-4 max-w-3xl text-base leading-relaxed text-white/90 sm:text-lg">{{summary}}</p>{{/if}}
  </div>
  <div class="flex h-1.5" aria-hidden="true">
    <span class="flex-[6] bg-brand-green"></span><span class="flex-1 bg-brand-yellow"></span><span class="flex-1 bg-brand-red"></span>
  </div>
</section>
