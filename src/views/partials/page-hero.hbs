{{!-- Page heading band with breadcrumb. Params: title, summary, parentLabel, parentHref --}}
<section class="border-b border-neutral-200 bg-neutral-50">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12" data-motion="enter">
    <nav aria-label="Breadcrumb" class="text-sm text-neutral-600">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-brand-blue hover:underline">Home</a></li>
        {{#if parentLabel}}
          <li aria-hidden="true">/</li>
          <li>{{#if parentHref}}<a href="{{parentHref}}" class="hover:text-brand-blue hover:underline">{{parentLabel}}</a>{{else}}{{parentLabel}}{{/if}}</li>
        {{/if}}
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-neutral-800">{{title}}</li>
      </ol>
    </nav>
    <h1 class="mt-3 text-3xl font-bold leading-tight text-brand-blue sm:text-4xl">{{title}}</h1>
    {{#if summary}}<p class="mt-4 max-w-3xl text-base leading-relaxed text-neutral-700 sm:text-lg">{{summary}}</p>{{/if}}
    <div class="mt-5 h-1 w-14 bg-brand-green" aria-hidden="true"></div>
  </div>
</section>
