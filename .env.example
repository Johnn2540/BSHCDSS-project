# Copy this file to .env and fill in real values. Never commit .env.

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (Neon Postgres)
# DATABASE_URL: Neon's POOLED connection string (host contains "-pooler"), used by the app.
# DIRECT_URL:   Neon's DIRECT connection string (no "-pooler"), used by Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Sessions (use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, used once by `npm run db:seed`.
# Remove ADMIN_PASSWORD from .env after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer / SMTP). Sending fails clearly if SMTP is not configured.
# Use port 587 with SMTP_SECURE=false (STARTTLS), or 465 with true.
# Gmail requires an app password and a verified alias when MAIL_FROM differs from SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BSHCDSS <no-reply@example.org>"
CONTACT_EMAIL=
